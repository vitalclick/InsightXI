# ──────────────────────────────────────────────────────────────
# InsightXI — environment template. Copy to .env and fill in.
# Never commit a real .env. Secrets stay out of version control.
# ──────────────────────────────────────────────────────────────

# ── Data backend: "memory" (deterministic seed, default) or "postgres" ──
DATA_BACKEND="memory"

# ── Database (Neon — managed Postgres; required when DATA_BACKEND=postgres) ──
DATABASE_URL="postgresql://user:password@host.neon.tech/insightxi?sslmode=require"

# ── Redis (queues + cache, BullMQ) ──
REDIS_URL="redis://localhost:6379"
# Background jobs are OFF by default so the API boots without Redis. Set true
# (with a reachable REDIS_URL) to run the hourly data refresh + adaptive
# recompute and the daily retrain job.
ENABLE_QUEUES="false"

# ── API (NestJS) ──
API_PORT=4000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
# Access tokens are short-lived; refresh tokens (below) extend the session
# without keeping a long-lived access token around.
JWT_REFRESH_EXPIRES_IN="30d"

# ── Security hardening ──
# Comma-separated web origin(s) allowed by CORS. REQUIRED in production — the
# API refuses to boot in production without this (or WEB_APP_URL). Blank in dev
# reflects any origin for local convenience.
CORS_ORIGINS=""
# IP-based rate limiting (dependency-free fixed window). Set ENABLED=false to
# turn off (e.g. when a gateway/Cloudflare already throttles).
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_MS="60000"
# Shared secret for API ↔ AI service calls. When set, the AI service rejects
# any request without a matching x-internal-key header. Leave blank for the
# local/offline stack (AI service runs open).
AI_SERVICE_TOKEN=""

# ──────────────────────────────────────────────────────────────
# Transactional email (verification, password reset, payment receipts).
# Live via the Resend HTTP API when RESEND_API_KEY is set; otherwise runs in
# sandbox mode and logs each message so the flow is exercisable offline.
# ──────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="InsightXI <no-reply@insightxi.app>"

# ── Web (Next.js) ──
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Public site origin — used for robots.txt + sitemap.xml absolute URLs.
NEXT_PUBLIC_SITE_URL="https://insightxi.app"
# Public OAuth client ids for the SPA. Leave blank to use sandbox/demo sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_APPLE_CLIENT_ID=""

# ──────────────────────────────────────────────────────────────
# Auth — Social sign-in (server-side verification)
# Leave keys blank to run in sandbox mode (accepts `mock:<provider>:<email>`
# tokens so the social-login flow is demoable offline).
# ──────────────────────────────────────────────────────────────
# Google: OAuth 2.0 Web client id(s), comma-separated (must match the SPA).
GOOGLE_CLIENT_ID=""
# Apple: the Services ID (client id) authorized for Sign in with Apple.
APPLE_CLIENT_ID=""

# ──────────────────────────────────────────────────────────────
# Premium billing — Plan is $2.49 USD / month (30 days access).
# Each gateway runs live when its keys are set, else in sandbox mode.
# ──────────────────────────────────────────────────────────────
# Where hosted checkouts redirect back to (the web app origin).
WEB_APP_URL="http://localhost:3000"
# Optional explicit payment callback base (defaults to WEB_APP_URL).
# PAYMENTS_CALLBACK_URL="http://localhost:3000"
# Optional FX overrides for display localization: JSON of { CODE: perUSD }.
# CURRENCY_RATES_JSON='{"NGN":1600,"GHS":15.5}'
# Currency auto-detection uses Cloudflare's cf-ipcountry header when present.
# If you are NOT behind Cloudflare, set an IP→country lookup URL ({ip} is
# substituted) so pricing localizes automatically. Leave blank to rely on
# Cloudflare + the in-app currency selector. Examples:
#   GEO_IP_LOOKUP_URL="https://ipapi.co/{ip}/country/"
#   GEO_IP_LOOKUP_URL="http://ip-api.com/json/{ip}?fields=countryCode"
GEO_IP_LOOKUP_URL=""

# PayPal (Orders v2). PAYPAL_ENV: "sandbox" (default) or "live".
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"
PAYPAL_WEBHOOK_ID=""

# Paystack (NGN/GHS/ZAR/KES/USD). Use test keys outside production.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Flutterwave (broad African + international coverage).
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
# The "verif-hash" secret configured on the Flutterwave webhook.
FLUTTERWAVE_WEBHOOK_HASH=""

# ── AI service (FastAPI) ──
AI_SERVICE_PORT=8000
AI_SERVICE_URL="http://localhost:8000"
# Where model + adaptive artifacts are read/written (joblib, metrics.json,
# experience.jsonl, adaptive_state.json). Defaults to apps/ai-service/models.
# MODELS_DIR="apps/ai-service/models"

# ──────────────────────────────────────────────────────────────
# Adaptive Intelligence Engine (continuous self-improvement).
# OFF by default: the service then behaves exactly like the static
# Poisson + Elo + ML blend. When ON it records predictions to Experience
# Memory, learns per-league blend weights + confidence calibration, and
# explains every adjustment. Adaptation is bounded and gated on evidence.
# See docs/adaptive-intelligence-engine.md.
# ──────────────────────────────────────────────────────────────
ADAPTIVE_ENABLED="false"
ADAPTIVE_CALIBRATION="true"
# Resolved predictions a (league) bucket needs before it adapts at all.
ADAPTIVE_MIN_SAMPLES="50"
# Max deviation of any model weight from its static baseline (bounded tilt).
ADAPTIVE_WEIGHT_DRIFT_CAP="0.20"
# EMA step for weight updates across recompute cycles (smaller = slower).
ADAPTIVE_WEIGHT_STEP="0.30"
# Exponential recency half-life (days) for weighting resolved evidence.
ADAPTIVE_RECENCY_HALFLIFE_DAYS="180"
# Experience retention window before old rows are rolled up.
EXPERIENCE_RETENTION_SEASONS="3"
# Optional artifact path overrides (default: alongside the model artifacts).
# EXPERIENCE_PATH="apps/ai-service/models/experience.jsonl"
# ADAPTIVE_STATE_PATH="apps/ai-service/models/adaptive_state.json"

# ── Football data provider (primary: API-Football) ──
# When FOOTBALL_API_KEY is set, live API-Football data is used; otherwise the
# deterministic mock seed provider is used.
FOOTBALL_API_KEY=""
FOOTBALL_API_BASE_URL="https://v3.football.api-sports.io"
# Comma-separated API-Football league ids (default 39=EPL, 140=La Liga).
FOOTBALL_LEAGUE_IDS="39,140"
# Season start year (e.g. 2025 -> "2025/26").
FOOTBALL_SEASON="2025"
