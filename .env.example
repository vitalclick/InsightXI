# ──────────────────────────────────────────────────────────────
# InsightXI — environment template. Copy to .env and fill in.
# Never commit a real .env. Secrets stay out of version control.
# ──────────────────────────────────────────────────────────────

# ── Data backend: "memory" (deterministic seed, default) or "postgres" ──
DATA_BACKEND="memory"

# ── Database (Neon — managed Postgres; required when DATA_BACKEND=postgres) ──
DATABASE_URL="postgresql://user:password@host.neon.tech/insightxi?sslmode=require"

# ── Redis (queues + cache, BullMQ) ──
REDIS_URL="redis://localhost:6379"

# ── API (NestJS) ──
API_PORT=4000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ── Web (Next.js) ──
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── AI service (FastAPI) ──
AI_SERVICE_PORT=8000
AI_SERVICE_URL="http://localhost:8000"

# ── Football data provider (primary: API-Football) ──
# When FOOTBALL_API_KEY is set, live API-Football data is used; otherwise the
# deterministic mock seed provider is used.
FOOTBALL_API_KEY=""
FOOTBALL_API_BASE_URL="https://v3.football.api-sports.io"
# Comma-separated API-Football league ids (default 39=EPL, 140=La Liga).
FOOTBALL_LEAGUE_IDS="39,140"
# Season start year (e.g. 2025 -> "2025/26").
FOOTBALL_SEASON="2025"
